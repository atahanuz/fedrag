# Copy to .env (scripts/colab_up.py writes the first two automatically).
FEDRAG_GPU_URL=https://your-tunnel.trycloudflare.com
FEDRAG_API_KEY=fedrag-...

# Optional: use any OpenAI-compatible endpoint for the agents instead of the gateway's vLLM.
# FEDRAG_LLM_BASE_URL=http://localhost:8001/v1
# FEDRAG_LLM_API_KEY=
# FEDRAG_LLM_MODEL=qwen3.8-27b
# FEDRAG_LLM_THINKING_FLAG=1      # send Qwen's enable_thinking flag; 0 for other models

# Optional: contact info for the web agent's User-Agent (Wikimedia requires one).
# FEDRAG_HTTP_CONTACT=you@example.com
